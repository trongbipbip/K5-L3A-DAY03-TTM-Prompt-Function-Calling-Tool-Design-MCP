# Day 03 Lab v2 — Research Agent
# Copy this file to `.env` (same folder) and fill in your keys.
# NEVER commit `.env` — it is gitignored. Keys here are NAMES ONLY (no values).

# --- Final submission: Groq via OpenAI-compatible adapter ---
# CLI: --provider openai --model openai/gpt-oss-120b
# UI: select openai, enter openai/gpt-oss-120b, version v4
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# --- Alternative providers (choose explicitly in CLI/UI) ---
# Remove OPENAI_BASE_URL above before using an OpenAI key at the default endpoint.
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# --- Local small model (bonus challenge, no key needed) ---
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# --- Research / read tools ---
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
RAPIDAPI_KEY=
RAPIDAPI_TWITTER_HOST=twitter-api45.p.rapidapi.com
ARXIV_USER_AGENT=AI20k-Day03-Research-Agent/1.0 (educational lab)

# --- Bonus delivery (optional, advanced track) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
